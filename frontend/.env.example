# ============================================================================
# Lunari Frontend - Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual settings.
# ============================================================================

# API Base URL (Fastify backend)
# For Android emulator: http://10.0.2.2:5000
# For physical device: http://<YOUR_LOCAL_IP>:5000 (e.g. http://192.168.1.100:5000)
# For web development: http://localhost:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# ============================================================================
# Firebase Authentication Client Configuration (Safe Public Keys)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ============================================================================
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:xxxxxxxxxxxxxxxxxxxxxx

# Firebase Web Client ID for Google Sign-In
# Obtain from Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK configuration
# Or Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client (auto created by Google Service)
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
