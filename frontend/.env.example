# ============================================================================
# Lunari Frontend - Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual settings.
# ============================================================================

# API Base URL
EXPO_PUBLIC_API_URL=http://localhost:5000

# Google OAuth Client IDs (Public client identifiers, NOT secrets - do NOT put client secrets here)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
