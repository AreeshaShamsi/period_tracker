# ============================================================================
# Lunari Backend - Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual settings.
# ============================================================================

# PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/period_tracker

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Configuration (comma-separated allowed origins, especially for production)
# CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:5000,http://127.0.0.1:5000

# ============================================================================
# Firebase Admin SDK Configuration (Server-Side ID Token Verification)
# Choose Option A (Environment Variables) or Option B (Service Account File) or Option C (Application Default Credentials)
# ============================================================================

# Option A: Explicit Environment Variables (Recommended for Render, Railway, Docker, CI)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Path to Service Account JSON Key file
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Option C: Google Application Default Credentials (GCP, Google Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Optional SSL Configuration (for cloud deployment, e.g. AWS RDS, Neon, Render)
# DATABASE_SSL=false
# DB_REJECT_UNAUTHORIZED=true
